# ==============================================================================
# Goodbaye Universal Standard - Git Ignore Rules
# Repository: https://github.com/alireza786786/ai-driven-v2ray
# ==============================================================================

# کش پایگاه داده و باینری‌ها (الزامی طبق تست‌های ناوردا)
.cache/

# فایل‌های موقت پایتون
__pycache__/
*.py[cod]
*$py.class
*.so

# فایل‌های موقت نگارش اتمیک
*.tmp
*.temp

# محیط‌های مجازی و لاگ‌ها
.venv/
venv/
ENV/
*.log

# تنظیمات ادیتورها و سیستم‌عامل
.vscode/
.idea/
.DS_Store
Thumbs.db
